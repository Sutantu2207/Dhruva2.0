# Dhruva.AI V2 — Core Foundation Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Service Metadata
SERVICE_NAME=dhruva-backend
API_V1_PREFIX=/api/v1

# Security & Secrets (Must be changed in staging/production)
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing (Argon2id parameters)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Database Configuration (PostgreSQL 16)
# Example PostgreSQL URL: postgresql+asyncpg://postgres:postgres@localhost:5432/dhruva_db
DATABASE_URL=sqlite+aiosqlite:///./dhruva_dev.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis Cache / Session Store (Optional in development, falls back to memory store)
# Example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_DEFAULT_PER_MINUTE=100

# CORS & Cookies
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
